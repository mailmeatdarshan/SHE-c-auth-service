{
    "name": "auth-service",
    "version": "1.0.0",
    "description": "Shri Hari Enterprises",
    "homepage": "https://github.com/mailmeatdarshan/SHE-c-auth-service#readme",
    "bugs": {
        "url": "https://github.com/mailmeatdarshan/SHE-c-auth-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mailmeatdarshan/SHE-c-auth-service.git"
    },
    "license": "ISC",
    "author": "Darshan Dubey <mailmeatdarshan@gmail.com>",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=dev nodemon --watch src --ext ts --exec tsx src/server.ts",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "lint:fix": "eslint . --fix",
        "lint:check": "eslint .",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --runInBand",
        "prepare": "husky",
        "start": "ts-node src/index.ts",
        "typeorm": "cross-env NODE_ENV=dev typeorm-ts-node-esm",
        "migration:create": "npm run typeorm -- migration:create --esm",
        "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts --esm",
        "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
        "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
        "migration:show": "npm run typeorm -- migration:show -d src/data-source.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/express-validator": "^2.20.33",
        "@types/http-errors": "^2.0.5",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.5",
        "@types/supertest": "^7.2.1",
        "@types/winston": "^2.4.4",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^17.6.0",
        "mock-jwks": "^3.3.5",
        "nodemon": "^3.1.14",
        "prettier": "3.9.10",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1"
    },
    "lint-staged": {
        "*.ts": [
            "npm run format:fix",
            "npm run lint:fix"
        ]
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "express-jwt": "^8.5.1",
        "express-validator": "^7.3.2",
        "http-errors": "^2.0.1",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.1.0",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "rsa-pem-to-jwk": "^1.1.3",
        "typeorm": "1.1.2",
        "winston": "^3.19.0"
    }
}
